# Replace the placeholder hostname only after valid HTTPS has been configured.
# Keep the real file outside the repository, owned by root, mode 0600.
NODE_ENV=production
THEIBS_HOST=127.0.0.1
PORT=4173
THEIBS_PUBLIC_ORIGIN=https://api.example.invalid
THEIBS_AUTH_REQUIRED=true
THEIBS_AUTH_GOOGLE_ENABLED=true
THEIBS_TRIAL_DAYS=3
SUPABASE_URL=https://kevcwoeqgdwvfsvdpghe.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
THEIBS_USER_DATA_ROOT=/var/lib/theibs/users
THEIBS_SOLVER_CACHE_PATH=/var/lib/theibs/solver-cache
THEIBS_WORKSPACE_PATH=/var/lib/theibs/local/workspace.json
THEIBS_DATA_PATH=/var/lib/theibs/local/training-events.jsonl
THEIBS_LLM_CONFIG_PATH=/var/lib/theibs/local/llm-config.json
THEIBS_STORAGE_PERSISTENT=true
# Copy the current access policy deliberately; do not grant additional access.
THEIBS_LIFETIME_EMAILS=
THEIBS_LIFETIME_USER_IDS=
# Payments and remote LLM remain unconfigured in this migration.
