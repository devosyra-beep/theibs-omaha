{
  "name": "theibs",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "assets": {
    "directory": ".output/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/app", "/app/", "/api", "/api/*", "/healthz"]
  },
  "vars": {
    "API_UPSTREAM": "https://theibs-omaha.onrender.com"
  },
  "observability": { "enabled": false }
}
