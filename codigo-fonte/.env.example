# Modo SaaS. Em desenvolvimento local deixe false.
THEIBS_AUTH_REQUIRED=false
THEIBS_PUBLIC_ORIGIN=https://app.seudominio.com
THEIBS_HOST=0.0.0.0
THEIBS_TRIAL_DAYS=3
THEIBS_PLAN_PRICE_BRL=250

# Supabase Auth/Data API. A publishable key pode ir ao navegador; a secret key jamais.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
THEIBS_AUTH_GOOGLE_ENABLED=true

# Acesso vitalício validado somente pelo backend.
THEIBS_LIFETIME_EMAILS=devosyra@gmail.com,ninjadevtester@gmail.com
THEIBS_LIFETIME_USER_IDS=

# AbacatePay v2. Produto avulso, preço 25000 centavos, sem cycle.
ABACATEPAY_API_KEY=
ABACATEPAY_PRODUCT_ID=
THEIBS_ABACATEPAY_WEBHOOK_SECRET=
# Escolha development no sandbox ou production somente após homologação.
THEIBS_BILLING_ENV=
# Defina true somente depois de aplicar e testar as migrações no projeto certo.
THEIBS_BILLING_SCHEMA_VERIFIED=false
# Habilite só os métodos efetivamente liberados na conta/produto. Ex: PIX,CARD.
# Vazio mantém toda criação de cobrança desativada.
THEIBS_PAYMENT_METHODS=
# Opcional: sobrescreve a chave HMAC publicada pela AbacatePay.
ABACATEPAY_HMAC_KEY=

# Diretório persistente e privado do servidor para históricos por usuário.
THEIBS_USER_DATA_ROOT=
# Marque true somente depois de montar e verificar um disco persistente.
THEIBS_STORAGE_PERSISTENT=false
