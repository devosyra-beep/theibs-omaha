{
  "name": "poker-omaha5-realtime-assistance",
  "version": "0.14.6-rc.1",
  "private": true,
  "description": "THEIBS: Omaha High PLO4, PLO5 and PLO6 analysis and training lab.",
  "type": "commonjs",
  "main": "desktop/main.js",
  "scripts": {
    "package:current": "node scripts/package-current.cjs",
    "test": "node --test \"test/*.test.cjs\"",
    "manual": "node src/manual-cli.js",
    "theibs": "node server.js",
    "desktop": "electron .",
    "webapp": "node webapp.js",
    "package:webapp": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-webapp.ps1",
    "package:win": "electron-builder --win portable",
    "start": "node server.js",
    "test:ui": "python scripts/test-ui.py",
    "test:desktop": "electron scripts/smoke-desktop.js",
    "test:reliability": "node scripts/qa-reliability.cjs",
    "test:math": "node scripts/validate-engine.cjs",
    "benchmark:keyboard": "node scripts/benchmark-keyboard-ui.cjs",
    "benchmark:interactive": "node scripts/benchmark-interactive.cjs",
    "validate:policy": "node scripts/evaluate-policy.cjs",
    "validate:analyze": "node scripts/evaluate-analyze.cjs"
  },
  "build": {
    "appId": "com.theibs.plo5",
    "productName": "THEIBS",
    "artifactName": "THEIBS.exe",
    "files": [
      "desktop/**/*",
      "public/**/*",
      "src/**/*",
      "scripts/**/*",
      "server.js",
      "package.json",
      "data/training-events.jsonl"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "1.62.1"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
